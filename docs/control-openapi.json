  "components": {
    "securitySchemes": {
      "RunToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Device": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "merchant": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "online": {
            "type": "boolean"
          },
          "setup_error": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "merchant",
          "online"
        ],
        "title": "Device",
        "type": "object"
      },
      "Engine": {
        "$defs": {
          "Counters": {
            "properties": {
              "accepted": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "approvals": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "delivered": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "requests": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "reversals": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "requests",
              "accepted",
              "approvals",
              "reversals",
              "delivered"
            ],
            "type": "object"
          },
          "Delivery": {
            "enum": [
              "normal",
              "disconnect_before_accept",
              "disconnect_after_commit",
              "disconnect_after_accept",
              "partial_response",
              "hang",
              "malformed_json",
              "http500",
              "http400",
              "wrong_content_type",
              "missing_fields",
              "unknown_code"
            ],
            "type": "string"
          },
          "Device": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "merchant": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "online": {
                "type": "boolean"
              },
              "setup_error": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "merchant",
              "online"
            ],
            "type": "object"
          },
          "Event": {
            "properties": {
              "at_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "charged": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "cursor": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "detail": {
                "type": "string"
              },
              "device_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "generation": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "kind": {
                "type": "string"
              },
              "operation_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "profile": {
                "type": "string"
              },
              "scenario_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unix_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "required": [
              "cursor",
              "generation",
              "at_ms",
              "profile",
              "kind",
              "detail"
            ],
            "type": "object"
          },
          "Mode": {
            "enum": [
              "automatic",
              "manual"
            ],
            "type": "string"
          },
          "Operation": {
            "properties": {
              "amount": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "charged": {
                "type": "boolean"
              },
              "completed_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "deadline_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "device_id": {
                "type": "string"
              },
              "error_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "id": {
                "type": "string"
              },
              "merchant": {
                "type": "string"
              },
              "response_delivered": {
                "type": "boolean"
              },
              "scenario": {
                "$ref": "#/components/schemas/Engine/$defs/Scenario"
              },
              "stage": {
                "$ref": "#/components/schemas/Engine/$defs/Stage"
              },
              "stage_started_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              },
              "started_ms": {
                "format": "uint64",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "device_id",
              "merchant",
              "amount",
              "stage",
              "started_ms",
              "stage_started_ms",
              "deadline_ms",
              "charged",
              "scenario",
              "response_delivered"
            ],
            "type": "object"
          },
          "Outcome": {
            "enum": [
              "approved",
              "declined",
              "error"
            ],
            "type": "string"
          },
          "Scenario": {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "default": null,
                "format": "uint64",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "delivery": {
                "$ref": "#/components/schemas/Engine/$defs/Delivery",
                "default": "normal"
              },
              "device_id": {
                "default": "00000000-0000-4000-8000-000000000001",
                "type": "string"
              },
              "error_id": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure_stage": {
                "$ref": "#/components/schemas/Engine/$defs/Stage",
                "default": "authorizing"
              },
              "id": {
                "default": "approved",
                "type": "string"
              },
              "manual_bank": {
                "default": false,
                "type": "boolean"
              },
              "merchant": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              },
              "mode": {
                "$ref": "#/components/schemas/Engine/$defs/Mode",
                "default": "automatic"
              },
